# Copy to .env and fill in your real GA4 Measurement ID once one exists.
# Injected into index.html's hardcoded gtag snippet at build time by the
# Vite plugin in vite.config.ts. Without this set, the build falls back to
# a dummy placeholder ("G-XXXXXXXXXX") — meant to only be set as a real
# environment variable in deployed environments (e.g. Render), not locally.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
